# Environment Configuration
NODE_ENV=development
APP_NAME=SISTEM-QC-BERKAS
APP_PORT=3001
APP_URL=http://localhost:3001

# Database Configuration
# Connection pool: connection_limit=20 (increase for production)
# pool_timeout=20 (seconds to wait for connection)
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/sistem_qc_berkas?connection_limit=20&pool_timeout=20"
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=admin123
DB_NAME=sistem_qc_berkas

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRATION=604800

# Logging
LOG_LEVEL=debug
LOG_FORMAT=simple

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Email Configuration (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Admin Credentials (initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
